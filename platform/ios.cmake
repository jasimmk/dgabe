set(CMAKE_SYSTEM_NAME iOS)
set(CMAKE_SYSTEM_PROCESSOR arm64)
set(CMAKE_OSX_ARCHITECTURES arm64 CACHE STRING "iOS architecture" FORCE)
set(CMAKE_OSX_SYSROOT "$ENV{SDKROOT}" CACHE PATH "Apple platform SDK" FORCE)
set(CMAKE_OSX_DEPLOYMENT_TARGET "$ENV{IPHONEOS_DEPLOYMENT_TARGET}" CACHE STRING "Minimum iOS version" FORCE)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_XCODE_ATTRIBUTE_CODE_SIGNING_ALLOWED NO)
